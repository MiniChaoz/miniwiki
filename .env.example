# Kopiere diese Datei zu ".env" und passe die Werte an.

# Langer, zufaelliger String. Erzeugen z.B. mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ersetze-mich-mit-einem-langen-zufaelligen-string

# MySQL-Verbindung (Benutzer/Passwort/Host/Datenbank anpassen)
DATABASE_URL=mysql+pymysql://wiki:dein-passwort@localhost/wiki

# Fuer schnelle lokale Tests ohne MySQL kann stattdessen SQLite genutzt werden:
# DATABASE_URL=sqlite:///wiki.db

# Anzeigename des Wikis im Kopfbereich
WIKI_NAME=MiniWiki

# Optionales Banner (z.B. TEST). Leer lassen fuer Produktion.
INSTANCE_LABEL=

# Auf "true" setzen, wenn das Wiki hinter HTTPS laeuft (empfohlen).
COOKIE_SECURE=false
